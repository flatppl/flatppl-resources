%%%
One flux amplitude, three true energies.
%%%
flatppl_compat = "0.1"
E = [0.5, 1.0, 2.0]
width = [0.5, 0.75, 1.0]
area = [100000.0, 200000.0, 300000.0]
tau = [0.05, 0.2, 0.5]
time = 10000.0

M = rowstack([[0.7, 0.2, 0.0],
              [0.1, 0.6, 0.7]])

unit_flux = E .^ (-2) .* exp.(-0.8 .* tau)
fold(a) = M * (time .* area .* width
    .* (a .* unit_flux))
amplitude = 0.00000001
signal = fold(amplitude)
a = elementof(nonnegreals)
bg = [2.0, 3.0]

on ~ Poisson.(fold(a) .+ bg)
off ~ Poisson.(4.0 .* bg)

data = record(on = [7, 8], off = [8, 12])
K = kernelof(record(on = on, off = off), a = a)
L = likelihoodof(K, data)
score = logdensityof(L, record(a = amplitude))
