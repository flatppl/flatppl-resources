%%%
Bose-symmetric, constant-width S-wave Dalitz model.
%%%
flatppl_compat = "0.1"
mpi = 0.13957039
mD = 1.86965
mR = 0.98
width = 0.07
kallen(x,y,z) = x^2+y^2+z^2-2*x*y-2*x*z-2*y*z
E(m) = (mD^2-m^2-mpi^2)/(2*m)
q(m) = sqrt(kallen(mD^2,m^2,mpi^2))/(2*m)
k(m) = sqrt(m^2/4-mpi^2)
s12(m,c) = 2*mpi^2+m*E(m)+2*q(m)*k(m)*c

# Dimensionless Breit-Wigner amplitude.
b = mR * width
delta(s) = mR^2 - s
bw(s) = b*(delta(s)+im*b)/(delta(s)^2+b^2)
amp(m,c,p) = 1+p.r*cis(p.phi)*(
    bw(s12(m,c))+bw(s12(m,-c)))
weight(x,p) = x[1]*q(x[1])*k(x[1]) * (
    abs2(amp(x[1],x[2],p)))

# Coordinates are m(pi- pi-) and cos(theta).
support = cartprod(interval(2*mpi,mD-mpi),
    interval(-1.0,1.0))
r = elementof(interval(0.0,2.0))
phi = elementof(interval(-pi,pi))
parameters = record(r = r, phi = phi)
raw = weighted(weight, Lebesgue(support),
    parameters)
pdf = normalize(raw)
K = functionof(pdf)
L = likelihoodof(K, [1.0, 0.35])

# A fixed weight for a numerical check.
check = weight([1.0,0.35], record(r=0.6,phi=0.7))
