%%%
Constant-width S-wave Dalitz model.
%%%
flatppl_compat = "0.1"
mpi = 0.13957039
mD = 1.86965
mR = 0.98
width = 0.07
hep = standard_module("particle-physics", "0.1")
E(m) = (mD^2-m^2-mpi^2)/(2*m)
q(m) = (mD/m)*hep.breakup_momentum(mD, m, mpi)
k(m) = hep.breakup_momentum(m, mpi, mpi)
s12(m,c) = 2*mpi^2+m*E(m)+2*q(m)*k(m)*c

b = mR * width
bw(s) = b * hep.resonance_breitwigner(
    s, mR, width, 0.0, 0.0, 0, 1.0)
wave(s,p) = p.r*cis(p.phi)*bw(s)
amp(m,c,p) = 1 + (wave(s12(m,c),p)
    + wave(s12(m,-c),p))
separate(u,v) = 1 + abs2(u) + abs2(v)
weight(x,p) = x[1]*q(x[1])*k(x[1]) * (
    abs2(amp(x[1],x[2],p)))

# Coordinates are m(pi- pi-) and cos(theta).
support = cartprod(interval(2*mpi,mD-mpi),
    interval(-1.0,1.0))
r = elementof(interval(0.0,2.0))
phi = elementof(interval(-pi,pi))
parameters = record(r = r, phi = phi)
raw = weighted(weight, Lebesgue(support),
    parameters)
pdf = normalize(raw)
K = functionof(pdf)
event = [1.0, 0.35]
L = likelihoodof(K, event)

p0 = record(r = 0.6, phi = 0.7)
check = weight(event, p0)
