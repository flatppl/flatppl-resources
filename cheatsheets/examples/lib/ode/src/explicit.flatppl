%%%
Fixed-step explicit methods for vector-valued ODEs.
%%%
flatppl_compat = "0.1"
euler_step(f, t, y, h, p) = y .+ h .* f(t, y, p)
heun_step(f, t, y, h, p) = heun_finish(f, t, y, h, p, f(t, y, p))
heun_finish(f, t, y, h, p, k1) = y .+ (h / 2) .* (k1 .+ f(t + h, y .+ h .* k1, p))
rk4_step(f, t, y, h, p) = rk4_2(f, t, y, h, p, f(t, y, p))
rk4_2(f, t, y, h, p, k1) = rk4_3(f, t, y, h, p, k1, f(t + h/2, y .+ (h/2) .* k1, p))
rk4_3(f, t, y, h, p, k1, k2) = rk4_4(f, t, y, h, p, k1, k2, f(t + h/2, y .+ (h/2) .* k2, p))
rk4_4(f, t, y, h, p, k1, k2, k3) = y .+ (h/6) .* (k1 .+ 2 .* k2 .+ 2 .* k3 .+ f(t + h, y .+ h .* k3, p))
vern7_step(f, t, y, h, p) = vern7_2(f, t, y, h, p, f(t, y, p))
vern7_2(f, t, y, h, p, k1) = vern7_3(f, t, y, h, p, k1, f(t + (0.005) * h, y .+ h .* ((0.005) .* k1), p))
vern7_3(f, t, y, h, p, k1, k2) = vern7_4(f, t, y, h, p, k1, k2, f(t + (0.10888888888888888) * h, y .+ h .* ((-1.07679012345679) .* k1 .+ (1.185679012345679) .* k2), p))
vern7_4(f, t, y, h, p, k1, k2, k3) = vern7_5(f, t, y, h, p, k1, k2, k3, f(t + (0.16333333333333333) * h, y .+ h .* ((0.04083333333333333) .* k1 .+ (0.1225) .* k3), p))
vern7_5(f, t, y, h, p, k1, k2, k3, k4) = vern7_6(f, t, y, h, p, k1, k2, k3, k4, f(t + (0.4555) * h, y .+ h .* ((0.6389139236255726) .* k1 .+ (-2.455672638223657) .* k3 .+ (2.272258714598084) .* k4), p))
vern7_6(f, t, y, h, p, k1, k2, k3, k4, k5) = vern7_7(f, t, y, h, p, k1, k2, k3, k4, k5, f(t + (0.6095094489978381) * h, y .+ h .* ((-2.6615773750187572) .* k1 .+ (10.804513886456137) .* k3 .+ (-8.3539146573962) .* k4 .+ (0.820487594956657) .* k5), p))
vern7_7(f, t, y, h, p, k1, k2, k3, k4, k5, k6) = vern7_8(f, t, y, h, p, k1, k2, k3, k4, k5, k6, f(t + (0.884) * h, y .+ h .* ((6.067741434696772) .* k1 .+ (-24.711273635911088) .* k3 .+ (20.427517930788895) .* k4 .+ (-1.9061579788166472) .* k5 .+ (1.006172249242068) .* k6), p))
vern7_8(f, t, y, h, p, k1, k2, k3, k4, k5, k6, k7) = vern7_9(f, t, y, h, p, k1, k2, k3, k4, k5, k6, k7, f(t + (0.925) * h, y .+ h .* ((12.054670076253203) .* k1 .+ (-49.75478495046899) .* k3 .+ (41.142888638604674) .* k4 .+ (-4.461760149974004) .* k5 .+ (2.042334822239175) .* k6 .+ (-0.09834843665406107) .* k7), p))
vern7_9(f, t, y, h, p, k1, k2, k3, k4, k5, k6, k7, k8) = vern7_finish(y, h, k1, k2, k3, k4, k5, k6, k7, k8, f(t + h, y .+ h .* ((10.138146522881808) .* k1 .+ (-42.6411360317175) .* k3 .+ (35.76384003992257) .* k4 .+ (-4.3480228403929075) .* k5 .+ (2.0098622683770357) .* k6 .+ (0.3487490460338272) .* k7 .+ (-0.27143900510483127) .* k8), p))
vern7_finish(y, h, k1, k2, k3, k4, k5, k6, k7, k8, k9) = y .+ h .* ((0.04715561848627222) .* k1 .+ (0.25750564298434153) .* k4 .+ (0.26216653977412624) .* k5 .+ (0.15216092656738558) .* k6 .+ (0.4939969170032485) .* k7 .+ (-0.29430311714032503) .* k8 .+ (0.08131747232495111) .* k9)
