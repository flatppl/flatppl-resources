flatppl_compat = "0.1"

# Distribution constructors and variates.
standard = Normal(0, 1)
shifted = Normal(mu = 2, sigma = 0.5)
x ~ standard
y ~ shifted

# Array-valued product measures.
n = 3
means = [0.0, 1.0, 2.0]
u ~ iid(standard, n)
v ~ Normal.(mu = means, sigma = 0.5)

# Support restriction and normalization.
positive = normalize(truncate(
    standard, interval(0, inf)))
z ~ positive

# Laws of scalar and array values.
scalar_law = lawof(x)
array_law = lawof(v)
