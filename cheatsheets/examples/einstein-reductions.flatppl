%%%
Two sensors measure the same three runs.
%%%
flatppl_compat = "0.1"
X = rowstack([[1, 0], [1, 1], [1, 2]])
B = rowstack([[1, 2], [2, -1]])
y = rowstack([[3, 3], [3, 3], [6, -1]])

pred[.t, .s] := X[.t, .k] * B[.s, .k]
r = y .- pred

sq[.t, .s] := r[.t, .s]^2
by_run[.t] := sq[.t, .s]
by_sensor[.s] := sq[.t, .s]
total[] := sq[.t, .s]

mse = aggregate(mean, [.s], sq[.t, .s])
within = aggregate(lall, [.t],
    abs(r[.t, .s]) <= 1)

gram[.a, .b] := r[.t, .a] * r[.t, .b]
diag_sum[] := gram[.s, .s]

log_L = logdensityof(Normal.(pred, 1.0), y)
outputs = record(pred = pred, cost = by_run,
    by_sensor = by_sensor, mse = mse,
    within = within, gram = gram,
    total = total, log_L = log_L)
