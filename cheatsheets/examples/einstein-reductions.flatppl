flatppl_compat = "0.1"

# Select, reorder and sum axes of a matrix.
A = rowstack([[1, 2, 0], [3, 1, 4]])
D = rowstack([[2, 5], [7, 3]])
square[.i, .j] := A[.i, .j]^2
rows[.i] := A[.i, .j]
cols[.j] := A[.i, .j]
total[] := A[.i, .j]
swap[.j, .i] := A[.i, .j]
second[.i] := A[.i, 2]
diag_cells[.i] := D[.i, .i]
diag_total[] := D[.i, .i]

# Multiply vectors and matrices.
u = [1, 2]
v = [3, 4]
w = [2, 1]
U = addaxes(u, 0, 1)
B = rowstack([[1, 2], [3, 1]])
C = rowstack([[2, 0], [1, 3]])
add_col[.i, .j] := A[.i, .j] + u[.i]
scale_rows[.i, .j] := (
    A[.i, .j] * U[.i, !])
dot_uv[] := u[.i] * v[.i]
outer_uv[.i, .j] := u[.i] * v[.j]
mv[.i] := B[.i, .j] * v[.j]
mm[.i, .k] := B[.i, .j] * C[.j, .k]
row_dot[.i] := B[.i, .j] * C[.i, .j]
hadamard[.i, .j] := B[.i, .j] * C[.i, .j]
frobenius[] := B[.i, .j] * C[.i, .j]
mm_w[.i, .k] := (
    B[.i, .j] * w[.j] * C[.j, .k])
loss[.i, .k] := (
    (B[.i, .j] - C[.j, .k])^2 * w[.j])
bilinear[] := u[.i] * B[.i, .j] * v[.j]

# Use .b for the first axis of a rank-three array.
X = array([1, 2, 3, 4, 5, 6, 7, 8], [2, 2, 2], [1, 2, 3])
V = rowstack([[1, 2], [2, 1]])
H = array([1, 2, 3, 4, 5, 6], [2, 1, 3], [1, 2, 3])
q = [1, 0, 1]
first_slice[.i, .j] := X[1, .i, .j]
slice_sums[.b] := X[.b, .i, .j]
middle[.b, .j] := X[.b, .i, .j]
traces[.b] := X[.b, .i, .i]
rotate[.j, .b, .i] := X[.b, .i, .j]
batch_mv[.b, .i] := (
    X[.b, .i, .j] * V[.b, .j])
batch_mm[.b, .i, .k] := (
    X[.b, .i, .j] * C[.j, .k])
norm_sq[] := X[.b, .i, .j]^2
rect_sum[.b, .j] := H[.b, .i, .j]
rect_mv[.b, .i] := H[.b, .i, .j] * q[.j]

# Choose the reduction.
W = rowstack([[1, 2, 6], [2, 4, 6]])
r_sum = aggregate(sum, [.i], W[.i, .j])
r_prod = aggregate(prod, [.i], W[.i, .j])
r_min = aggregate(minimum, [.i], W[.i, .j])
r_max = aggregate(maximum, [.i], W[.i, .j])
r_mean = aggregate(mean, [.i], W[.i, .j])
r_median = aggregate(median, [.i], W[.i, .j])
r_var = aggregate(var, [.i], W[.i, .j])
r_std = aggregate(std, [.i], W[.i, .j])
r_any = aggregate(lany, [.j], W[.i, .j] >= 4)
r_all = aggregate(lall, [.j], W[.i, .j] >= 4)
r_max_global = aggregate(maximum, [], W[.i, .j])
r_safe = aggregate(lall, [], W[.i, .j] < 6)
hits[.i] := ifelse(
    W[.i, .j] >= 4, 1, 0)
pair_prod = aggregate(prod, [.i, .k],
    B[.i, .j] + C[.j, .k])

# Look up positions through integer arrays.
p = [2, 1, 2]
c = [3, 1]
pick = u[p]
take = A[:, c]
along[.i] := take[.i, 1]
subgrid = A[p, c]
by_get[.j] := get(A, 1, .j)

# Sum or select within groups.
M = rowstack([[1, 0], [0, 1], [1, 0], [0, 1]])
x = [3, 2, 5, 4]
a = [1, 1, 2, 1]
ng[.k] := M[.i, .k]
totg[.k] := M[.i, .k] * x[.i]
wg[.k] := M[.i, .k] * a[.i]
atot[.k] := M[.i, .k] * a[.i] * x[.i]
avg = totg ./ ng
wavg = atot ./ wg
topg = aggregate(maximum, [.k],
    ifelse(M[.i, .k] >= 1, x[.i], -inf))

# Chain aggregations by naming their intermediate arrays.
R = rowstack([[1, 6], [3, 2]])
mu = aggregate(mean, [.j], R[.i, .j])
E[.i, .j] := R[.i, .j] - mu[.j]
cov[.j, .k] := E[.i, .j] * E[.i, .k]
peak = aggregate(maximum, [.j],
    W[.i, .j])
ties = aggregate(lany, [.i, .j],
    W[.i, .j] >= peak[.j])

# Change the pair operation or the reducer.
minplus = aggregate(minimum, [.i, .k],
    B[.i, .j] + C[.j, .k])
maxplus = aggregate(maximum, [.i, .k],
    B[.i, .j] + C[.j, .k])
maxprod = aggregate(maximum, [.i, .k],
    B[.i, .j] * C[.j, .k])
P = rowstack([[0, 1], [1, 0]])
Q = rowstack([[1, 0], [1, 1]])
paths = aggregate(lany, [.i, .k],
    P[.i, .j] * Q[.j, .k] >= 1)
triple[.i, .l] := (
    B[.i, .j] * C[.j, .k] * B[.k, .l])
loop3[] := (
    B[.i, .j] * C[.j, .k] * B[.k, .i])

# Retain four axes, then select or contract pairs of them.
K[.i, .j, .k, .l] := (
    B[.i, .j] * C[.k, .l])
kplane[.k, .l] := K[2, 1, .k, .l]
ksum[.i, .j] := K[.i, .j, .k, .l]
ktrace[] := K[.i, .i, .k, .k]

outputs = record(
    square = square, rows = rows, cols = cols, total = total,
    swap = swap, second = second, diag_cells = diag_cells, diag_total = diag_total,
    add_col = add_col, scale_rows = scale_rows,
    dot_uv = dot_uv, outer_uv = outer_uv, mv = mv, mm = mm,
    row_dot = row_dot, mm_w = mm_w, bilinear = bilinear,
    hadamard = hadamard, frobenius = frobenius, loss = loss,
    first_slice = first_slice, slice_sums = slice_sums, middle = middle,
    traces = traces, rotate = rotate, batch_mv = batch_mv, batch_mm = batch_mm,
    norm_sq = norm_sq, rect_sum = rect_sum, rect_mv = rect_mv,
    r_sum = r_sum, r_prod = r_prod, r_min = r_min, r_max = r_max,
    r_mean = r_mean, r_median = r_median, r_var = r_var, r_std = r_std,
    r_any = r_any, r_all = r_all, r_max_global = r_max_global,
    r_safe = r_safe, hits = hits, pair_prod = pair_prod,
    pick = pick, take = take, along = along, subgrid = subgrid, by_get = by_get,
    ng = ng, totg = totg, wg = wg, atot = atot, avg = avg, wavg = wavg, topg = topg,
    mu = mu, E = E, cov = cov, peak = peak, ties = ties,
    minplus = minplus, maxplus = maxplus, maxprod = maxprod, paths = paths,
    triple = triple, loop3 = loop3,
    K = K, kplane = kplane, ksum = ksum, ktrace = ktrace)
