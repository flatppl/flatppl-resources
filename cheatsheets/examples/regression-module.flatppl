%%%
Pulse counts in one-second exposures.
%%%
flatppl_compat = "0.1"
reg = standard_module("regression", "0.1")

runs = table(
    level = [-1, 0, 1, -1, 0, 1],
    high = [0, 0, 0, 1, 1, 1],
    counts = [3, 5, 7, 5, 13, 22])
X = colstack([runs.level, runs.high])

alpha ~ Normal(0.0, 2.0)
beta ~ iid(Normal(0.0, 1.0), 2)
y ~ reg.PoissonLogGLM(X, alpha, beta)

prior = lawof(record(alpha = alpha, beta = beta))
K = kernelof(record(y = y), alpha, beta)
L = likelihoodof(K, record(y = runs.counts))
posterior = bayesupdate(L, prior)

eta = alpha .+ X * beta
mean_count = exp.(eta)
predict = functionof(mean_count, alpha, beta)
base_rate = 4.0
rate_ratio = [2.0, 3.0]
point = record(alpha = log(base_rate),
    beta = log.(rate_ratio))
fitted = predict(point)
log_L = logdensityof(L, point)
