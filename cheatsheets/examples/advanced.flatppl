%%%
A two-component mixture for five readings.
%%%
flatppl_compat = "0.1"
y_data = [-1.1, -0.7, 0.2, 1.4, 3.0]
n = lengthof(y_data)
p = elementof(unitinterval)
mu = elementof(reals)

M1 = Normal(mu, 0.7)
M2 = Gamma(shape = 2, rate = 1)
mix = superpose(weighted(p, M1),
    weighted(1 - p, M2))
readings = iid(mix, n)

batch = superpose(weighted(p, iid(M1, n)),
    weighted(1 - p, iid(M2, n)))

K = functionof(joint(y = readings))
K_batch = functionof(joint(y = batch))
obs = record(y = y_data)
L = likelihoodof(K, obs)
L_batch = likelihoodof(K_batch, obs)

prior = joint(p = Beta(2, 2),
    mu = Normal(0, 2))
posterior = bayesupdate(L, prior)

point = record(p = 0.4, mu = -1.0)
log_readings = logdensityof(L, point)
log_batch = logdensityof(L_batch, point)
