flatppl_compat = "0.1"

# Fixed arrays and parametric inputs.
x_data = [0.0, 1.0, 2.0]
y_data = [1.1, 2.8, 5.2]
sigma = 0.5
alpha = elementof(reals)
beta = elementof(reals)

# A named function with a single expression.
affine(a, b, x) = a .+ b .* x
mu = affine(alpha, beta, x_data)

# Inferred and explicit function boundaries.
f_auto = functionof(mu)
f = functionof(mu, a = alpha, b = beta)
coefficients = record(a = 1.0, b = 2.0)
at_point = f(coefficients)

# A stochastic graph with the same boundary.
y ~ Normal.(mu, sigma)
K = kernelof(record(y = y),
    a = alpha, b = beta)
L = likelihoodof(K, record(y = y_data))
