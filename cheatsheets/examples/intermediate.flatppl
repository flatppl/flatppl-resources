%%%
Noncentered grouped logistic regression.
%%%
flatppl_compat = "0.1"
G = 3
x_data = [-1.2, 0.4, 1.1, -0.3, 0.8, 2.0]
group_data = [1, 2, 3, 1, 2, 3]
y_data = [0, 1, 1, 0, 1, 1]

# Population parameters and group effects.
mu_a ~ Normal(0, 1)
tau ~ LogNormal(0, 0.5)
z ~ iid(Normal(0, 1), G)
a = mu_a .+ tau .* z
beta ~ Normal(0, 2)

# Gather one group intercept per observation.
eta = a[group_data] .+ beta .* x_data
probability = invlogit.(eta)
y ~ Bernoulli.(probability)

# The prior retains z, not its transform a.
prior = lawof(record(mu_a = mu_a,
    tau = tau, z = z, beta = beta))
K = kernelof(record(y = y),
    mu_a, tau, z, beta)
L = likelihoodof(K, record(y = y_data))
posterior = bayesupdate(L, prior)

# Evaluate the observation model at a point.
point = record(mu_a = 0.0, tau = 1.0,
    z = [0.0, 0.0, 0.0], beta = 1.0)
log_L = logdensityof(L, point)
