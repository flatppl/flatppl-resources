%%%
One sensor residual in two coordinate systems.
%%%
flatppl_compat = "0.1"
r = [2.0, 1.0]
I2 = eye(2)
J = rowstack([[1.0, 1.0], [0.0, 1.0]])

q = J * r
G = J * transpose(J)

I2: old[] := r[.i^] * r[.i_]
G: dist2[] := q[.i^] * q[.i_]
raw[] := q[.i] * q[.i]

dual = inv(G) * q
parts[.i] := q[.i] * dual[.i]

G: grad[.i_] := 2.0 * q[.i_]
step = [0.0, 1.0]
G: slope[] := grad[.i_] * step[.i^]

noise = MvNormal([0.0, 0.0], G)
log_L = logdensityof(noise, q)
outputs = record(distance2 = dist2,
    log_L = log_L, directional = slope)
