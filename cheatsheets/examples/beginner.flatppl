%%%
Linear regression with an optional prior.
%%%
flatppl_compat = "0.1"
x_data = [0.0, 1.0, 2.0, 3.0]
y_data = [0.8, 2.1, 2.9, 4.2]

# Parameter domains.
alpha = elementof(reals)
beta = elementof(reals)
sigma = elementof(posreals)

# One mean for each observation.
mu = alpha .+ beta .* x_data
y ~ Normal.(mu, sigma)
K = kernelof(record(y = y))
L = likelihoodof(K, record(y = y_data))

# Optional prior on the named parameters.
a ~ Normal(0, 5)
b ~ Normal(0, 2)
s ~ LogNormal(0, 0.5)
prior = lawof(record(alpha = a,
    beta = b, sigma = s))
posterior = bayesupdate(L, prior)

point = record(alpha = 1.0,
    beta = 1.0, sigma = 0.5)
log_L = logdensityof(L, point)

f_mean = functionof(mu, alpha, beta)
fitted = f_mean(alpha = 1.0, beta = 1.0)
