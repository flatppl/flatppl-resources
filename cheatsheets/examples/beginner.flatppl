flatppl_compat = "0.1"

# Fixed values and a parameter domain.
sigma = 0.5
y_data = [0.8, 1.1, 1.0]
n = lengthof(y_data)
mu = elementof(reals)

# Stochastic and deterministic expressions.
y ~ iid(Normal(mu, sigma), n)
residual = y .- mu
result = record(y = y, residual = residual)

# Kernel reification and observed data.
K = kernelof(y)
L = likelihoodof(K, y_data)

# A named parameter point.
point = record(mu = 1.0)
log_L = logdensityof(L, point)
